# ---------------------------------------------------------------- datastore
# Local:  mongodb://localhost:27017/hundredmph
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/hundredmph?retryWrites=true&w=majority
# Keep the cluster in an Indian region (Mumbai) — README §7.6.
MONGODB_URI=mongodb://localhost:27017/hundredmph

# ------------------------------------------------------------------- server
PORT=9090

# --------------------------------------------------------------------- auth
# MUST be at least 32 bytes and MUST be set in production — the app refuses to
# start with a short one. Rotate quarterly (README §7.5).
#   openssl rand -base64 48
JWT_SECRET=

# ISO-8601 durations. Short access, long rotating refresh.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Brute-force throttle, per email address.
AUTH_MAX_FAILED_LOGINS=10
AUTH_FAILED_LOGIN_WINDOW=PT15M
AUTH_LOCK_DURATION=PT30M
AUTH_PASSWORD_RESET_TTL=PT1H

# --------------------------------------------------------------------- CORS
# Expo web dev server and any LAN origin you hit during development.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --------------------------------------------------------------- deployment
# Production: prod. Turns seeding off and locks CORS to the list above.
# SPRING_PROFILES_ACTIVE=prod

# The first admin on an empty database — created once, never overwritten.
# 12+ characters. Change it from the app after the first sign-in.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=100mph Admin

# --------------------------------------------------------------------- seed
# Writes the demo accounts from the app's mock.ts into empty collections.
# MUST be false anywhere real members exist — README §8.1.
SEED_ENABLED=true

# ------------------------------------------------------------ not yet wired
# Phase 5 (billing) and Phase 6 (media). Listed so the shape is known.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
